rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'aadamali989@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'favorites', 'online', 'lastSeen', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'role', 'favorites', 'online', 'lastSeen', 'createdAt', 'updatedAt',
          'bio', 'avatarUrl'
        ])
        && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.role in ['user', 'admin']
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 400))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 12000))
        && data.favorites is list && data.favorites.size() <= 100
        && (data.favorites.size() == 0 || (data.favorites[0] is string && data.favorites[0].size() <= 128))
        && data.online is bool
        && data.lastSeen is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBook(data) {
      return data.keys().hasAll([
          'title', 'author', 'category', 'description', 'coverUrl', 'fileUrl',
          'fileName', 'fileType', 'allowDownload', 'published', 'contentText',
          'createdBy', 'ratingSum', 'ratingCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'author', 'category', 'description', 'coverUrl', 'fileUrl',
          'fileName', 'fileType', 'allowDownload', 'published', 'contentText',
          'createdBy', 'ratingSum', 'ratingCount', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.description is string && data.description.size() <= 2000
        && data.coverUrl is string && data.coverUrl.size() <= 2000
        && data.fileUrl is string && data.fileUrl.size() <= 2000
        && data.fileName is string && data.fileName.size() <= 255
        && data.fileType in ['pdf', 'epub', 'txt', 'article']
        && data.allowDownload is bool
        && data.published is bool
        && data.contentText is string && data.contentText.size() <= 50000
        && isValidId(data.createdBy)
        && data.ratingSum is int && data.ratingSum >= 0
        && data.ratingCount is int && data.ratingCount >= 0
        && data.ratingSum >= data.ratingCount
        && data.ratingSum <= data.ratingCount * 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookRating(data, bookId, userId) {
      return data.keys().hasAll(['userId', 'bookId', 'rating', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'bookId', 'rating', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.bookId == bookId
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReadingProgress(data, userId, bookId) {
      return data.keys().hasAll([
          'userId', 'bookId', 'percentage', 'currentPage', 'totalPages', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'bookId', 'percentage', 'currentPage', 'totalPages', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.bookId == bookId
        && data.percentage is int && data.percentage >= 0 && data.percentage <= 100
        && data.currentPage is int && data.currentPage >= 1 && data.currentPage <= 10000
        && data.totalPages is int && data.totalPages >= 1 && data.totalPages <= 10000
        && data.currentPage <= data.totalPages
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyReadingLog(data, userId, dateKey) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'secondsRead', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'secondsRead', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.dateKey == dateKey
        && data.secondsRead is int && data.secondsRead >= 0 && data.secondsRead <= 86400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookComment(data, bookId) {
      return data.keys().hasAll([
          'userId', 'bookId', 'authorName', 'text', 'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'bookId', 'authorName', 'text', 'published', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && isValidId(data.bookId)
        && data.bookId == bookId
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1500
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function matchesAtomicRatingDelta(ratingPath, prevSum, prevCount) {
      let afterRating = getAfter(ratingPath).data.rating;
      return afterRating is int && afterRating >= 1 && afterRating <= 5 && (
        (!exists(ratingPath)
          && incoming().ratingCount == prevCount + 1
          && incoming().ratingSum == prevSum + afterRating) ||
        (exists(ratingPath)
          && incoming().ratingCount == prevCount
          && incoming().ratingSum == prevSum - get(ratingPath).data.rating + afterRating)
      );
    }

    function isAtomicRatingAggregateUpdate(bookId) {
      let prevSum = ('ratingSum' in existing()) ? existing().ratingSum : 0;
      let prevCount = ('ratingCount' in existing()) ? existing().ratingCount : 0;
      let ratingPath = /databases/$(database)/documents/books/$(bookId)/ratings/$(request.auth.uid);
      return existing().published == true
        && incoming().diff(existing()).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'updatedAt'])
        && existsAfter(ratingPath)
        && matchesAtomicRatingDelta(ratingPath, prevSum, prevCount);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastSeen == request.time
        && (incoming().role == 'user' || isBootstrappedAdmin());
      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'bio', 'avatarUrl', 'role', 'favorites', 'online', 'lastSeen', 'updatedAt'
          ])) ||
          (isOwner(userId) && incoming().role == existing().role && (
            incoming().diff(existing()).affectedKeys().hasOnly(['favorites', 'updatedAt']) ||
            (incoming().diff(existing()).affectedKeys().hasOnly(['online', 'lastSeen', 'updatedAt']) && incoming().lastSeen == request.time) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'avatarUrl', 'updatedAt'])
          ))
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /progress/{bookId} {
        allow get: if isValidId(userId) && isValidId(bookId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(bookId)
          && isOwner(userId)
          && isValidReadingProgress(incoming(), userId, bookId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/books/$(bookId));
        allow update: if isValidId(userId)
          && isValidId(bookId)
          && isOwner(userId)
          && isValidReadingProgress(incoming(), userId, bookId)
          && incoming().userId == existing().userId
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'percentage', 'currentPage', 'totalPages', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(bookId) && (isOwner(userId) || isAdmin());
      }

      match /readingLogs/{dateKey} {
        allow get: if isValidId(userId) && isValidDateKey(dateKey) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidDailyReadingLog(incoming(), userId, dateKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidDateKey(dateKey)
          && isOwner(userId)
          && isValidDailyReadingLog(incoming(), userId, dateKey)
          && incoming().userId == existing().userId
          && incoming().dateKey == existing().dateKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().secondsRead >= existing().secondsRead
          && incoming().diff(existing()).affectedKeys().hasOnly(['secondsRead', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidDateKey(dateKey) && (isOwner(userId) || isAdmin());
      }
    }

    match /books/{bookId} {
      allow get: if isValidId(bookId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isValidId(bookId)
        && isAdmin()
        && isValidBook(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().ratingSum == 0
        && incoming().ratingCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bookId)
        && isSignedIn()
        && isValidBook(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAtomicRatingAggregateUpdate(bookId) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'author', 'category', 'description', 'coverUrl', 'fileUrl',
            'fileName', 'fileType', 'allowDownload', 'published', 'contentText', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(bookId) && isAdmin();

      match /ratings/{userId} {
        allow get: if isValidId(bookId) && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create: if isValidId(bookId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookRating(incoming(), bookId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/books/$(bookId)).data.published == true
          && getAfter(/databases/$(database)/documents/books/$(bookId)).data.updatedAt == request.time;
        allow update: if isValidId(bookId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidBookRating(incoming(), bookId, userId)
          && incoming().userId == existing().userId
          && incoming().bookId == existing().bookId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'updatedAt'])
          && get(/databases/$(database)/documents/books/$(bookId)).data.published == true
          && getAfter(/databases/$(database)/documents/books/$(bookId)).data.updatedAt == request.time;
        allow delete: if isValidId(bookId) && isValidId(userId) && isAdmin();
      }

      match /comments/{commentId} {
        allow get: if isValidId(bookId)
          && isValidId(commentId)
          && (existing().published == true || isAdmin());
        allow list: if resource.data.published == true || isAdmin();
        allow create: if isValidId(bookId)
          && isValidId(commentId)
          && isSignedIn()
          && isValidBookComment(incoming(), bookId)
          && incoming().userId == request.auth.uid
          && incoming().published == true
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/books/$(bookId)).data.published == true;
        allow update: if isValidId(bookId)
          && isValidId(commentId)
          && isSignedIn()
          && isValidBookComment(incoming(), bookId)
          && incoming().userId == existing().userId
          && incoming().bookId == existing().bookId
          && incoming().authorName == existing().authorName
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'published', 'updatedAt']))
          );
        allow delete: if isValidId(bookId)
          && isValidId(commentId)
          && isSignedIn()
          && (isOwner(existing().userId) || isAdmin());
      }
    }
  }
}
